# Resend API key — create at https://resend.com, verify the nowva.ai domain first
RESEND_API_KEY=

# Where preorder reservations are delivered (defaults to contact@nowva.ai)
# On Vercel Preview, set to delivered@resend.dev for end-to-end tests
PREORDER_TO=

# Set to 1 to log form submissions instead of sending email (local testing)
PREORDER_DRY_RUN=
