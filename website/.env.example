# Resend API key — create at https://resend.com, verify the nowvasports.com domain first
RESEND_API_KEY=

# Where preorder reservations are delivered (defaults to info@nowvasports.com)
# On Vercel Preview, set to delivered@resend.dev for end-to-end tests
PREORDER_TO=

# Set to 1 to log form submissions instead of sending email (local testing)
PREORDER_DRY_RUN=

# Neon Postgres connection string (auto-injected by the Vercel → Neon
# Marketplace integration). Unset → reservations fall back to email-only
# capture, logged loudly.
DATABASE_URL=

# Resend Audience to add each new reservation contact to (Resend dashboard →
# Audiences). Unset → audience sync is skipped (logged); reservations still
# succeed.
RESEND_AUDIENCE_ID=
